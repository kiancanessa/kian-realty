# Copy to .env.local and fill in your values

# Required for live EasyBroker listings
EASYBROKER_API_KEY=

# Required for the contact/inquiry forms to actually send.
# Get a free access key at https://web3forms.com (no signup, just enter
# the destination email and they email you the key).
NEXT_PUBLIC_WEB3FORMS_KEY=

# Shared secret for the /api/cron/* routes. Any long random string; the same
# value must be sent as "Authorization: Bearer <secret>" by whatever triggers
# the cron (Vercel Cron sends it automatically once set as an env var).
CRON_SECRET=

# --- Redes sociales (módulo /admin/social) ---

# Vercel Blob store, used to host the images/videos uploaded from the admin.
# Instagram's publishing API downloads the media from a public URL, so files
# cannot live on the local filesystem. Created automatically when you connect
# a Blob store to the project in the Vercel dashboard.
BLOB_READ_WRITE_TOKEN=

# Meta Graph API — the Facebook Page and its linked Instagram Business account.
# The Instagram account MUST be a Business account linked to the Page, or the
# publishing API will reject every request.
#   1. Get added as a person with full Page access in Meta Business Suite.
#   2. Create a Business app at developers.facebook.com.
#   3. In Graph API Explorer, grant: pages_show_list, pages_manage_posts,
#      pages_read_engagement, instagram_basic, instagram_content_publish.
#   4. Exchange the short-lived token for a long-lived one:
#      GET /oauth/access_token?grant_type=fb_exchange_token&client_id=...&client_secret=...&fb_exchange_token=<short>
#   5. Get the non-expiring Page token:
#      GET /{PAGE_ID}?fields=access_token&access_token=<long_lived_user_token>
#   6. Find the linked IG account: GET /{PAGE_ID}?fields=instagram_business_account
# Set these in Vercel → Project Settings → Environment Variables. Never commit them.
META_PAGE_ID=
META_IG_BUSINESS_ACCOUNT_ID=
META_PAGE_ACCESS_TOKEN=
